APP_NAME="FLARE Scientific Intelligence API"
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Optional for API-only mode. Required for explicit DB checks/migrations.
# Uncomment and replace placeholders locally. Percent-encode special password characters.
# DATABASE_URL=postgresql+psycopg://flare_app:REPLACE_ME@localhost:5432/flare_dev
# TEST_DATABASE_URL=postgresql+psycopg://flare_test:REPLACE_ME@localhost:5432/flare_test_REPLACE_WITH_32_HEX_UUID
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
